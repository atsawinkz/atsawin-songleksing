# ==============================================================================
# Rice Disease RAG Chatbot - Environment Variables Template
# Copy this file to .env and replace the placeholder values with your real keys.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Used for Text Generation (Gemini 2.5 Flash) and Embeddings (gemini-embedding-001)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# Pinecone Vector Database
# Get your API key from Pinecone Console: https://app.pinecone.io/
# Used for storing and retrieving domain knowledge vectors (3072 dimensions)
# ------------------------------------------------------------------------------
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX_NAME="rice-knowledge"

# ------------------------------------------------------------------------------
# LINE Messaging API
# Get credentials from LINE Developers Console: https://developers.line.biz/
# Used for Webhook verification and replying with LINE Flex Messages
# ------------------------------------------------------------------------------
LINE_CHANNEL_SECRET="your_line_channel_secret_here"
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"

# ------------------------------------------------------------------------------
# (Optional) OpenCodeZen / Judge LLM API Key
# Used only during automated RAGAS evaluation with DeepSeek V4 Judge
# ------------------------------------------------------------------------------
OPENCODE_ZEN_API_KEY="your_opencode_zen_api_key_here"

# ------------------------------------------------------------------------------
# Server Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=8000
HOST="0.0.0.0"
