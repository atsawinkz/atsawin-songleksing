{
  "name": "Rice Disease LINE Chatbot Workflow (RT-DETR + RAG)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "line-webhook",
        "options": {}
      },
      "name": "LINE Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.events[0].message.type }}",
        "rules": {
          "rules": [
            {
              "value2": "image",
              "output": 0
            },
            {
              "value2": "text",
              "output": 1
            }
          ]
        }
      },
      "name": "Switch: Image or Text",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api-data.line.me/v2/bot/message/{{ $node['LINE Webhook Trigger'].json.body.events[0].message.id }}/content",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "file"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer srZk2fjM1+PZaoxdLrO0FPTUXTSrI8DSspN3TCqhjX+neJsNWNGQ6IWLioDcfYh7pnzduuu5T1WNzptIW4VTpk0qoYyoYZJwo577jTWik3Sini+YXUHEJoCkVPT2Irbfxkhmjvd1SgcLJswiJClJ2QdB04t89/1O/w1cDnyilFU="
            }
          ]
        }
      },
      "name": "Fetch Image from LINE API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        720,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/diagnose_and_advise",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {}
      },
      "name": "Call RT-DETR & RAG API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        940,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer srZk2fjM1+PZaoxdLrO0FPTUXTSrI8DSspN3TCqhjX+neJsNWNGQ6IWLioDcfYh7pnzduuu5T1WNzptIW4VTpk0qoYyoYZJwo577jTWik3Sini+YXUHEJoCkVPT2Irbfxkhmjvd1SgcLJswiJClJ2QdB04t89/1O/w1cDnyilFU="
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  replyToken: $node['LINE Webhook Trigger'].json.body.events[0].replyToken,\n  messages: [\n    {\n      type: 'text',\n      text: 'ผลการวินิจฉัยโรคข้าว:\\n' + $json.detection.message + '\\n\\nคำแนะนำและการรักษา:\\n' + $json.advice\n    }\n  ]\n}) }}",
        "options": {}
      },
      "name": "LINE Reply (Image Result)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1160,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/rag_query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  question: $node['LINE Webhook Trigger'].json.body.events[0].message.text\n}) }}",
        "options": {}
      },
      "name": "Call RAG Query API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        720,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer srZk2fjM1+PZaoxdLrO0FPTUXTSrI8DSspN3TCqhjX+neJsNWNGQ6IWLioDcfYh7pnzduuu5T1WNzptIW4VTpk0qoYyoYZJwo577jTWik3Sini+YXUHEJoCkVPT2Irbfxkhmjvd1SgcLJswiJClJ2QdB04t89/1O/w1cDnyilFU="
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  replyToken: $node['LINE Webhook Trigger'].json.body.events[0].replyToken,\n  messages: [\n    {\n      type: 'text',\n      text: $json.answer\n    }\n  ]\n}) }}",
        "options": {}
      },
      "name": "LINE Reply (Text RAG)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        940,
        420
      ]
    }
  ],
  "connections": {
    "LINE Webhook Trigger": {
      "main": [
        [
          {
            "node": "Switch: Image or Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch: Image or Text": {
      "main": [
        [
          {
            "node": "Fetch Image from LINE API",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Call RAG Query API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Image from LINE API": {
      "main": [
        [
          {
            "node": "Call RT-DETR & RAG API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call RT-DETR & RAG API": {
      "main": [
        [
          {
            "node": "LINE Reply (Image Result)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call RAG Query API": {
      "main": [
        [
          {
            "node": "LINE Reply (Text RAG)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
